{
  "name": "arkan-altaameer",
  "private": true,
  "version": "0.1.0",
  "description": "Bilingual (Arabic / English) corporate website for Arkan Altaameer United Co. — general contracting, interior finishing, stretch ceilings and interior fit-out in Riyadh.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zain-mo1/arkan-altaameer.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "media": "node scripts/build-media.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:artifact": "node scripts/build-artifact.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "framer-motion": "^13.4.4",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
